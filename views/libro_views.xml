<odoo>

<record id="view_biblioteca_libro_list" model="ir.ui.view">
<field name="model">biblioteca.libro</field>
<field name="arch" type="xml">
    <list>
    <field name="titulo"/>
    <field name="autor"/>
    <field name="paginas"/>
    <field name="disponible"/>
    <field name="editorial_id"/>
    <field name="generos_ids"/>
    </list>
</field>
</record>
<record id="view_biblioteca_editorial_list" model="ir.ui.view">
<field name="model">biblioteca.editorial</field>
<field name="arch" type="xml">
    <list>
    <field name="nombre"/>
    </list>
</field>
</record>
<record id="view_biblioteca_genero_list" model="ir.ui.view">
<field name="model">biblioteca.genero</field>
<field name="arch" type="xml">
    <list>
    <field name="nombre"/>
    </list>
</field>
</record>
<record id="view_biblioteca_libro_form" model = "ir.ui.view">
<field name="model">biblioteca.libro</field>
<field name="arch" type = "xml">
<form>
    <sheet>
        <group>
            <field name="titulo"/>
            <field name="autor"/>
            <field name="paginas"/>
            <field name="disponible" readonly="1"/>
            <field name="editorial_id"/>
            <field name="generos_ids"/>
            <field name="descripcion_paginas"/>
            <button name = "prestar" type = "object" string = "Prestar"/>
            <button name = "devolver" type = "object" string = "Devolver"/>
        </group>
    </sheet>
</form>
</field>
</record>
<record id="view_biblioteca_libro_form_extension" model="ir.ui.view">
        <field name="inherit_id" ref="view_biblioteca_libro_form"></field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
        <xpath expr="//field[@name = 'titulo']" position="after">
        <field name = "isbn"/>
        </xpath>
        </field>
</record>
<record id="view_biblioteca_editorial_form" model = "ir.ui.view">
<field name="model">biblioteca.editorial</field>
<field name="arch" type = "xml">
<form>
    <sheet>
        <group>
            <field name="nombre"/>
            <field name="libro_ids"/>
        </group>
    </sheet>
</form>
</field>
</record>
<record id="view_biblioteca_genero_form" model = "ir.ui.view">
<field name="model">biblioteca.genero</field>
<field name="arch" type = "xml">
<form>
    <sheet>
        <group>
            <field name="nombre"/>
        </group>
    </sheet>
</form>
</field>
</record>
<record id ="action_biblioteca_libro" model="ir.actions.act_window">
<field name="res_model">biblioteca.libro</field>
<field name="view_mode">list,form</field>
</record>
<record id ="action_biblioteca_editorial" model="ir.actions.act_window">
<field name="res_model">biblioteca.editorial</field>
<field name="view_mode">list,form</field>
</record>
<record id ="action_biblioteca_genero" model="ir.actions.act_window">
<field name="res_model">biblioteca.genero</field>
<field name="view_mode">list,form</field>
</record>
<menuitem id="menu_biblioteca_root" name="Biblioteca"/>
<menuitem id="menu_biblioteca_libros" name = "Libros" parent = "menu_biblioteca_root" action = "action_biblioteca_libro"/>
<menuitem id="menu_biblioteca_editoriales" name = "Editoriales" parent = "menu_biblioteca_root" action = "action_biblioteca_editorial"/>
<menuitem id="menu_biblioteca_generos" name = "Generos" parent = "menu_biblioteca_root" action = "action_biblioteca_genero"/>
</odoo>